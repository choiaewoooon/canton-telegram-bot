# ============================================================
# Canton Telegram Bot - 환경변수 설정
# 이 파일을 .env로 복사한 후 값을 채워주세요
# cp .env.example .env
# ============================================================

# --- Telegram (필수) ---
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHANNEL_ID=@your_channel_id

# --- Twitter/X (필수) ---
# ScrapeCreators API 키 (주 소스). https://scrapecreators.com 에서 발급
# 2026-07-17 RapidAPI twitter241 게이트웨이 전역 장애로 교체됨
SCRAPECREATORS_API_KEY=your_scrapecreators_key_here
# RAPIDAPI_KEY: deprecated (twitter241 사망). 복구 시 폴백용으로만 유지
RAPIDAPI_KEY=

# --- CoinGecko (선택) ---
# https://www.coingecko.com/en/api 에서 무료 Demo API Key 발급
# 없어도 동작하지만 레이트 리밋에 걸릴 수 있음
COINGECKO_API_KEY=

# --- 스케줄 ---
SCHEDULE_HOUR=9
SCHEDULE_MINUTE=0
TIMEZONE=Asia/Seoul
